// GGML CGraph FlatBuffer Schema
// This schema defines a serializable representation of ggml_cgraph
// that packs all tensor data into a continuous buffer

namespace GGML.Serialization;

// Tensor data type enum
enum TensorType : ubyte {
    F32 = 0,
    F16 = 1,
    Q4_0 = 2,
    Q4_1 = 3,
    Q5_0 = 6,
    Q5_1 = 7,
    Q8_0 = 8,
    Q8_1 = 9,
    Q2_K = 10,
    Q3_K = 11,
    Q4_K = 12,
    Q5_K = 13,
    Q6_K = 14,
    Q8_K = 15,
    IQ2_XXS = 16,
    IQ2_XS = 17,
    IQ3_XXS = 18,
    IQ1_S = 19,
    IQ4_NL = 20,
    IQ3_S = 21,
    IQ2_S = 22,
    IQ4_XS = 23,
    I8 = 24,
    I16 = 25,
    I32 = 26,
    I64 = 27,
    F64 = 28,
    IQ1_M = 29,
    BF16 = 30,
    Q4_0_4_4 = 31,
    Q4_0_4_8 = 32,
    Q4_0_8_8 = 33,
    TQ1_0 = 34,
    TQ2_0 = 35
}

// Tensor operation enum (simplified, only common ones)
enum TensorOp : ubyte {
    NONE = 0,
    DUP = 1,
    ADD = 2,
    ADD_ID = 3,
    ADD1 = 4,
    ACC = 5,
    SUB = 6,
    MUL = 7,
    DIV = 8,
    SQR = 9,
    SQRT = 10,
    LOG = 11,
    SIN = 12,
    COS = 13,
    SUM = 14,
    SUM_ROWS = 15,
    MEAN = 16,
    ARGMAX = 17,
    COUNT_EQUAL = 18,
    REPEAT = 19,
    REPEAT_BACK = 20,
    CONCAT = 21,
    SILU_BACK = 22,
    NORM = 23,
    RMS_NORM = 24,
    RMS_NORM_BACK = 25,
    GROUP_NORM = 26,
    L2_NORM = 27,
    MUL_MAT = 28,
    MUL_MAT_ID = 29,
    OUT_PROD = 30,
    SCALE = 31,
    SET = 32,
    CPY = 33,
    CONT = 34,
    RESHAPE = 35,
    VIEW = 36,
    PERMUTE = 37,
    TRANSPOSE = 38,
    GET_ROWS = 39,
    GET_ROWS_BACK = 40,
    SET_ROWS = 41,
    DIAG = 42,
    DIAG_MASK_INF = 43,
    DIAG_MASK_ZERO = 44,
    SOFT_MAX = 45,
    SOFT_MAX_BACK = 46,
    ROPE = 47,
    ROPE_BACK = 48,
    CLAMP = 49,
    CONV_TRANSPOSE_1D = 50,
    IM2COL = 51,
    IM2COL_BACK = 52,
    IM2COL_3D = 53,
    CONV_2D = 54,
    CONV_3D = 55,
    CONV_2D_DW = 56,
    CONV_TRANSPOSE_2D = 57,
    POOL_1D = 58,
    POOL_2D = 59,
    POOL_2D_BACK = 60,
    UPSCALE = 61,
    PAD = 62,
    PAD_REFLECT_1D = 63,
    ROLL = 64,
    ARANGE = 65,
    TIMESTEP_EMBEDDING = 66,
    ARGSORT = 67,
    LEAKY_RELU = 68,
    FLASH_ATTN_EXT = 69,
    FLASH_ATTN_BACK = 70,
    SSM_CONV = 71,
    SSM_SCAN = 72,
    WIN_PART = 73,
    WIN_UNPART = 74,
    GET_REL_POS = 75,
    ADD_REL_POS = 76,
    RWKV_WKV6 = 77,
    GATED_LINEAR_ATTN = 78,
    RWKV_WKV7 = 79,
    UNARY = 80,
    MAP_CUSTOM1 = 81,
    MAP_CUSTOM2 = 82,
    MAP_CUSTOM3 = 83,
    CUSTOM = 84,
    CROSS_ENTROPY_LOSS = 85,
    CROSS_ENTROPY_LOSS_BACK = 86,
    OPT_STEP_ADAMW = 87,
    OPT_STEP_SGD = 88,
    GLU = 89,
    // Note: GGML_OP_COUNT is not a real op, so it's omitted.
    // The original simplified ops like GELU, SILU, RELU are covered by UNARY.
}

// Fixed-size arrays for tensor dimensions and strides
struct TensorDimensions {
    ne0: int64;
    ne1: int64;
    ne2: int64;
    ne3: int64;
}

struct TensorStrides {
    nb0: uint64;
    nb1: uint64;
    nb2: uint64;
    nb3: uint64;
}

// Serialized tensor structure
table SerializedTensor {
    type: TensorType;
    ne: TensorDimensions;        // dimensions (up to 4D)
    nb: TensorStrides;           // strides in bytes
    op: TensorOp;
    op_params: [int32];   // operation parameters
    flags: int32;
    
    // Source tensor references (indices into tensors array)
    src: [uint32];        // source tensor indices
    
    // View information
    view_src: uint32 = 0; // source tensor index for views (0 = no view)
    view_offs: uint64;    // view offset
    
    // Data location in continuous buffer
    data_offset: uint64;  // offset in the continuous data buffer
    data_size: uint64;    // size of data in bytes
    
    name: string;         // tensor name
}

// Hash set for visited tensors during graph traversal
table HashSet {
    size: uint64;
    used_bits: [ubyte];   // bitset for used slots
    keys: [uint32];       // tensor indices (keys)
}

// Graph evaluation order
enum GraphEvalOrder : ubyte {
    LEFT_TO_RIGHT = 0,
    RIGHT_TO_LEFT = 1
}

// Serialized computation graph
table SerializedCGraph {
    size: int32;                    // maximum number of nodes/leafs/grads/grad_accs
    n_nodes: int32;                 // number of nodes currently in use
    n_leafs: int32;                 // number of leafs currently in use
    
    // All tensors (nodes, grads, grad_accs, leafs) in one array
    tensors: [SerializedTensor];
    
    // Indices into tensors array
    node_indices: [uint32];         // indices of node tensors
    grad_indices: [uint32];         // indices of gradient tensors
    grad_acc_indices: [uint32];     // indices of gradient accumulator tensors
    leaf_indices: [uint32];         // indices of leaf tensors
    
    use_counts: [int32];            // usage counts indexed by hash table slot
    
    visited_hash_set: HashSet;      // hash set for visited tensors
    
    order: GraphEvalOrder;          // evaluation order
    
    // Continuous data buffer containing all tensor data
    data_buffer: [ubyte];           // all tensor data packed consecutively
}

root_type SerializedCGraph;